# Copy to deploy/staging/staging.env on the server. Never commit the real file.
# STAGING_HOST can initially be <SERVER_IP>.sslip.io, then a real subdomain later.
STAGING_HOST=203-0-113-10.sslip.io

# Use URL-safe hexadecimal values so DATABASE_URL needs no escaping.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
BANK_DATA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

TZ=UTC
DEFAULT_DISPLAY_TIMEZONE=Asia/Riyadh
LOG_LEVEL=info
ADMIN_TOTP_ISSUER=LAR Staging Admin

STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_STRONG_STORAGE_SECRET
STORAGE_BUCKET_NAME=lar-staging
STORAGE_FORCE_PATH_STYLE=true

EMAIL_PROVIDER_MODE=mock
EMAIL_REQUIRED=false
MAP_PROVIDER_MODE=manual
